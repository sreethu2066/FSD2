<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>CargoTransportationSystem</display-name>

    <welcome-file-list>
        <welcome-file>login.jsp</welcome-file>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Central RBAC Authentication Filter -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.cargo.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/customer/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/driver/*</url-pattern>
    </filter-mapping>

    <!-- Session Configuration: 30 minutes timeout -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
    </session-config>

    <!-- Servlets -->
    <servlet>
        <servlet-name>AdminPaymentServlet</servlet-name>
        <servlet-class>com.cargo.controller.AdminPaymentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminPaymentServlet</servlet-name>
        <url-pattern>/admin/payments</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminFeedbackServlet</servlet-name>
        <servlet-class>com.cargo.controller.AdminFeedbackServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminFeedbackServlet</servlet-name>
        <url-pattern>/admin/feedback</url-pattern>
    </servlet-mapping>

</web-app>
